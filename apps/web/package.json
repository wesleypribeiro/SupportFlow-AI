{
  "name": "@supportflow/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @supportflow/contracts",
    "dev": "next dev --hostname 127.0.0.1",
    "lint": "eslint .",
    "pretypecheck": "npm run build --workspace @supportflow/contracts",
    "typecheck": "next typegen && tsc --noEmit",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1"
  },
  "dependencies": {
    "@supportflow/contracts": "*",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.1"
  }
}
