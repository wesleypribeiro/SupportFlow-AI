HOST=127.0.0.1
PORT=3001
SCHOOL_ID=school_demo

# Opcionais nesta fundação. Configure ambos apenas no backend quando usar a LLM.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Canal opcional. Segredos pertencem exclusivamente ao backend.
# Habilitar registra o webhook de validação; ainda não processa mensagens ou envia.
WHATSAPP_ENABLED=false
# Todos os campos abaixo são obrigatórios ao habilitar o canal.
# META_APP_SECRET=substitua-pelo-segredo-local-da-aplicacao
# META_WEBHOOK_VERIFY_TOKEN=defina-um-token-local-de-verificacao
# META_ACCESS_TOKEN=substitua-pelo-token-local-de-acesso
# META_WABA_ID=substitua-pelo-identificador-da-conta
# META_PHONE_NUMBER_ID=substitua-pelo-identificador-do-numero
# Versão verificada: apps/api/src/channels/whatsapp/meta/compatibility.md
# META_GRAPH_API_VERSION=v26.0
# CSV de IDs opacos de participantes autorizados da demonstração, sem itens vazios.
# Espaços nas bordas são removidos; duplicatas exatas preservam só a primeira.
# WHATSAPP_DEMO_RECIPIENTS=participante-demo-a,participante-demo-b
